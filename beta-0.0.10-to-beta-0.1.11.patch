+                return logger;
+            },
+            clearContext(scanId = null) {
+                if (!scanId || context.scanId === scanId) context = {};
+                return logger;
+            },
+            flush,
+            getContext: () => ({...context}),
+            getOriginalMethod: (level) => originalMethods.get(level) ?? null
+        };
+        registry.set(normalizedSource, logger);
+        return logger;
+    };
