{
    "manifest_version": 3,
    "name": "Image Finder",
    "version": "0.1.12",
    "version_name": "Beta 0.1.12",
    "description": "Find images on the current website.",
    "icons": {
        "64": "assets/icons/icon512.png"
    },
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "downloads",
        "offscreen",
        "declarativeNetRequestWithHostAccess"
    ],
    "background": {
        "scripts": [
            "vendor/jszip.min.js",
            "src/background.js"
        ],
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "src/debug-logger.js",
                "src/deepscan-frame.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/content.js",
                "src/classes/CarouselScanner.js",
                "src/classes/DeepScanController.js",
                "src/classes/DocumentTraverser.js",
                "src/classes/PhotoSwipeScanner.js",
                "src/classes/ContainerAnalyser.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "action": {
        "default_title": "Image Finder",
        "default_icon": "assets/icons/icon512.png",
        "default_popup": "ui/popup.html"
    },
    "options_ui": {
        "page": "ui/settings.html",
        "open_in_tab": false
    }
}
