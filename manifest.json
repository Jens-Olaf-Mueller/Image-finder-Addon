{
    "manifest_version": 3,
    "name": "Image Finder",
    "version": "0.2.2",
    "version_name": "Beta 0.2.2",
    "description": "Find media on the current website.",
    "icons": {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    },
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "downloads",
        "offscreen",
        "declarativeNetRequestWithHostAccess"
    ],
    "background": {
        "service_worker": "src/background/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "src/shared/debug-logger.js",
                "src/scan/deepscan-frame.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/scan/content.js",
                "src/scan/classes/CarouselScanner.js",
                "src/scan/classes/DeepScanController.js",
                "src/scan/classes/DeepScanDOMState.js",
                "src/scan/classes/DocumentTraverser.js",
                "src/scan/classes/PhotoSwipeScanner.js",
                "src/scan/classes/ContainerAnalyser.js",
                "src/scan/sites/classes/OnlyFansScanner.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "action": {
        "default_title": "Image Finder",
        "default_icon": {
            "16": "assets/icons/icon16.png",
            "32": "assets/icons/icon32.png",
            "48": "assets/icons/icon48.png",
            "128": "assets/icons/icon128.png"
        },
        "default_popup": "ui/popup.html"
    },
    "options_ui": {
        "page": "ui/settings.html",
        "open_in_tab": false
    }
}
